{
  "name": "knobel-manager-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "local": "vite",
    "local:remote": "vite --mode production",
    "api:gen": "rtk-query-codegen-openapi src/store/openapi-config.cjs",
    "build": "tsc -b && vite build --mode production",
    "check": "tsc --noEmit && biome ci . && i18next-cli status && i18next-cli lint && i18next-cli extract --ci",
    "fix": "biome check --write .",
    "test": "node --test 'src/**/*.test.ts'",
    "test:e2e": "playwright test",
    "knip": "knip",
    "knip:fix": "knip --fix --format",
    "preview": "vite preview",
    "prepare": "husky",
    "clean": "rm -rf node_modules dist",
    "deploy": "pnpm build && firebase deploy --only hosting"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@mantine/modals": "^9.7.5",
    "@mantine/notifications": "^9.7.5",
    "@reduxjs/toolkit": "^2.14.0",
    "@tabler/icons-react": "^3.50.0",
    "firebase": "^13.2.0",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "i18next-cli": "^1.82.4",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
