{
  "name": "knobel-manager-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prod": "vite --mode production",
    "local": "vite",
    "api:gen": "rtk-query-codegen-openapi src/store/openapi-config.cjs",
    "build": "tsc -b && vite build --mode production",
    "check": "tsc --noEmit && biome ci . && i18next-cli status && i18next-cli lint && i18next-cli extract --ci",
    "fix": "biome check --write .",
    "test": "node --test 'src/**/*.test.ts'",
    "knip": "knip",
    "knip:fix": "knip --fix --format",
    "preview": "vite preview",
    "prepare": "husky",
    "clean": "rm -rf node_modules dist",
    "deploy": "pnpm build && firebase deploy --only hosting"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@tabler/icons-react": "^3.46.0",
    "firebase": "^12.17.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.8",
    "@rolldown/plugin-babel": "^0.2.3",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "i18next-cli": "^1.69.2",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
