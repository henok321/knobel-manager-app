{
  "name": "knobel-manager-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "local": "vite",
    "local:remote": "vite --mode production",
    "api:gen": "rtk-query-codegen-openapi src/store/openapi-config.cjs",
    "build": "tsc -b && vite build --mode production",
    "check": "tsc --noEmit && biome ci . && i18next-cli status && i18next-cli lint && i18next-cli extract --ci",
    "fix": "biome check --write .",
    "test": "node --test 'src/**/*.test.ts'",
    "test:e2e": "playwright test",
    "knip": "knip",
    "knip:fix": "knip --fix --format",
    "preview": "vite preview",
    "prepare": "husky",
    "clean": "rm -rf node_modules dist",
    "deploy": "pnpm build && firebase deploy --only hosting"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/modals": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@tabler/icons-react": "^3.46.0",
    "firebase": "^12.19.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "i18next-cli": "^1.73.2",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "oxc-transform-react": "^0.149.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
